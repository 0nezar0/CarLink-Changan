    <string name="carlink_settings_root">Mode root</string>
    <string name="carlink_settings_root_detail">Untuk stereo berakar. Memungkinkan segala sesuatu setup meminta tanpa popup, dan terus Wi-Fi dalam mode rendah-latensi sementara telepon tersambung. Manajer root anda bertanya sekali.</string>
    <string name="carlink_settings_root_unavailable">Root tidak tersedia atau ditolak, jadi mode Root tidak aktif.</string>
    <string name="carlink_settings_auto_hotspot">Hidupkan hotspot mobil di</string>
    <string name="carlink_settings_auto_hotspot_detail">Ketika koneksi nirkabel membutuhkan hotspot stereo dan itu mati, CarLink mencoba untuk menyalakannya. Kebutuhan " Ubah pengaturan sistem " untuk CarLink; beberapa stereo hanya mengizinkannya dengan debug disetujui.</string>
    <string name="carlink_settings_external_bt">Nirkabel melalui modul Bluetooth stereo (eksperimental)</string>
    <string name="carlink_settings_external_bt_detail">Ini stereo Bluetooth adalah modul terpisah. Wireless Android Auto dan CarPlay mencapai telepon Anda melalui itu; pada secara baku. Matikan jika gangguan nirkabel pada stereo ini; USB masih bekerja. Aplikasi dari koneksi berikutnya.</string>
    <string name="carlink_settings_external_bt_fyt_note">Pertama menonaktifkan sendiri stereo “ Car Link ” app (com.syu.carlink) dalam Android Settings › Apps.</string>
    <string name="carlink_settings_method">Metode koneksi</string>
    <string name="carlink_settings_method_detail">Bagaimana telepon dan mobil berbagi Wi-Fi</string>
    <string name="carlink_settings_method_auto">Otomatis</string>
    <string name="carlink_settings_method_same_wifi">Sama Wi-Fi</string>
    <string name="carlink_settings_method_hotspot">Mobil hotspot</string>
    <string name="carlink_settings_method_auto_detail">Pilih jalur terbaik sebelum koneksi: sama Wi-Fi, lalu hot spot mobil, lalu Wi-Fi Direct. Dengan Android Auto itu juga terhubung melalui server unit telepon ketika berada di dan keduanya berada di satu jaringan.</string>
    <string name="carlink_settings_method_same_wifi_detail">Telepon dan mobil pada satu router, jalan tercepat. Perlu sandi Wi-Fi sekali.</string>
    <string name="carlink_settings_method_direct_detail">Hubungan langsung antara telepon dan mobil. Tidak perlu jaringan.</string>
    <string name="carlink_settings_method_headunit_server">Server unit kepala (pengembang)</string>
    <string name="carlink_settings_method_headunit_server_detail">Android Auto saja. Pertama, di telepon: Android Auto pengaturan › tap Versi sampai konfigurasi pengembang membuka ›} › Mulai server unit kepala (lagi setelah setiap start ulang telepon). Mobil harus di hotspot telepon atau sama Wi-Fi sebagai telepon. Otomatis, hotspot mobil dan Sama Wi-Fi coba juga; pilih ini untuk menggunakannya sendiri.</string>
    <string name="carlink_settings_method_sheet_body">Bluetooth selalu memulai koneksi; gambar dan suara kemudian melakukan perjalanan di atas Wi-Fi.</string>
    <string name="carlink_settings_hotspot">Mobil hotspot</string>
    <string name="carlink_settings_hotspot_detail">Nama dan sandi hotspot mobil sendiri</string>
    <string name="carlink_settings_hotspot_sheet_body">CarLink membacanya dari mobil dimana dia bisa dan mengirimkannya ke ponselmu. Change them here and CarLink changes the car \'s hotspot too, where Android allowed it.</string>
    <string name="carlink_settings_hotspot_read">Baca dari mobil</string>
    <string name="carlink_settings_hotspot_reading">Membaca hotspot mobil …</string>
    <string name="carlink_settings_hotspot_unreadable">stereo ini tidak membiarkan CarLink membaca hotspot nya. Masukkan nama dan sandi persis seperti pengaturan hotspot mobil menunjukkan mereka.</string>
    <string name="carlink_settings_hotspot_applied">hotspot mobil sekarang menggunakan nama ini dan password</string>
    <string name="carlink_settings_hotspot_not_applied">Tersimpan di CarLink. stereo ini tidak membiarkan CarLink mengubah hotspot nya: mengatur nama dan password yang sama dalam pengaturan hotspot mobil.</string>
    <string name="carlink_settings_same_wifi">Jaringan sama Wi-Fi</string>
    <string name="carlink_settings_same_wifi_detail">Router baik mobil dan iPhone Anda bergabung</string>
    <string name="carlink_settings_same_wifi_sheet_body">Mobil harus sudah berada di Wi-Fi ini. CarLink memberitahu Anda iPhone untuk bergabung lebih Bluetooth.</string>
    <string name="carlink_settings_headunit_server_address">Alamat telepon</string>
    <string name="carlink_settings_headunit_server_address_detail">Opsional. CarLink menemukan telepon dengan sendirinya: pertama hotspot telepon, kemudian sisa jaringan.</string>
    <string name="carlink_settings_headunit_server_address_auto">Cari secara otomatis</string>
    <string name="carlink_settings_headunit_server_sheet_body">Sebelum menyambung, nyalakan server unit kepala di telepon: Android Auto atur › tekan Versi sampai pengaturan pengembang terbuka › › Mulai unit kepala server. Lakukan lagi setelah setiap telepon dijalankan ulang. Tinggalkan alamat kosong untuk menemukan telepon secara otomatis, atau ketik alamat Wi-Fi (misalnya 192.168.43.1).</string>
