    <string name="carlink_setup_welcome_eyebrow">Bem-vindo</string>
    <string name="carlink_setup_welcome_title">Vamos ligar o seu telemóvel</string>
    <string name="carlink_setup_welcome_body">O CarLink executa o Apple CarPlay para iPhone e o Android Auto para telemóveis Android, por cabo ou sem fios. A configuração demora cerca de dois minutos.</string>
    <string name="carlink_setup_welcome_start">Começar</string>
    <string name="carlink_setup_plan_access">Permitir o acesso</string>
    <string name="carlink_setup_plan_access_detail">Bluetooth, Wi-Fi e alguns interruptores, tudo de uma vez</string>
    <string name="carlink_setup_plan_car">Escolha o seu carro</string>
    <string name="carlink_setup_plan_car_detail">A respetiva marca; um BYD recebe os extras DiLink</string>
    <string name="carlink_setup_plan_pair">Emparelhe o seu telemóvel</string>
    <string name="carlink_setup_plan_pair_detail">Uma vez, nas definições de Bluetooth do telemóvel</string>
