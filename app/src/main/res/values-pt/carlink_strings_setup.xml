    <string name="carlink_setup_permissions_title">Permita o que o CarLink precisa</string>
    <string name="carlink_setup_permissions_body">O Android pede cada um uma vez. Permita já os recomendados para nada pedir enquanto conduz; os opcionais podem esperar.</string>
    <string name="carlink_setup_permissions_all">Permitir tudo</string>
