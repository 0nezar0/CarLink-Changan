    <string name="carlink_setup_perm_wifi_detail">Configura a ligação Wi-Fi privada com o telemóvel</string>
    <string name="carlink_setup_perm_location">Localização</string>
    <string name="carlink_setup_perm_location_detail">O Android precisa dela para o Wi-Fi Direct; os mapas recebem a posição do carro</string>
    <string name="carlink_setup_perm_local_network">Rede local</string>
    <string name="carlink_setup_perm_local_network_detail">Permite que o CarPlay sem fios chegue ao iPhone</string>
    <string name="carlink_setup_perm_microphone">Microfone</string>
    <string name="carlink_setup_perm_microphone_detail">Siri, Google Assistant e chamadas</string>
    <string name="carlink_setup_perm_notifications">Notificações</string>
    <string name="carlink_setup_perm_notifications_detail">Mostra que o CarLink está ligado e permite-lhe interrompê-lo</string>
    <string name="carlink_setup_perm_overlay">Mostrar sobre outras aplicações</string>
    <string name="carlink_setup_perm_overlay_detail">Permite que o CarLink se abra sozinho quando o telemóvel se liga</string>
    <string name="carlink_setup_perm_battery">Executar em segundo plano</string>
    <string name="carlink_setup_perm_battery_detail">Mantém a ligação quando o ecrã entra em suspensão</string>
    <string name="carlink_setup_perm_vpn">Ligação CarPlay por cabo</string>
    <string name="carlink_setup_perm_vpn_detail">Permite que o CarPlay funcione pelo cabo USB. Nada vai para a internet através dele</string>
    <string name="carlink_setup_car_eyebrow">O seu carro</string>
    <string name="carlink_setup_car_title">Em que carro está este ecrã?</string>
    <string name="carlink_setup_car_body">Escolha a marca. Pode alterá-la mais tarde em Definições › Carro.</string>
    <string name="carlink_setup_size_eyebrow">Tamanho do ecrã</string>
    <string name="carlink_setup_size_title">Que tamanho devem ter os elementos?</string>
    <string name="carlink_setup_size_body">O tamanho dos ícones e do texto no CarPlay e no Android Auto. O médio serve a maioria dos ecrãs, por isso pode saltar isto. Altere-o quando quiser em Definições › Ecrã.</string>
    <string name="carlink_setup_pair_eyebrow">Emparelhe o seu telemóvel</string>
    <string name="carlink_setup_pair_waiting_title">No telemóvel, abra o Bluetooth e toque em %1$s</string>
    <string name="carlink_setup_pair_waiting_title_unnamed">No telemóvel, abra o Bluetooth e toque no nome deste ecrã</string>
    <string name="carlink_setup_pair_waiting_body">Mantenha este ecrã aberto. Se o telemóvel mostrar um código, confirme que coincide aqui e toque em Emparelhar.</string>
    <string name="carlink_setup_pair_pairing_title">A emparelhar com %1$s…</string>
    <string name="carlink_setup_pair_pairing_title_unnamed">A emparelhar com o seu telemóvel…</string>
    <string name="carlink_setup_pair_pairing_body">Confirme o código no telemóvel e neste ecrã.</string>
