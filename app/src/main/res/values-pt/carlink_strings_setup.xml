    <string name="carlink_setup_pair_accept_android">Aceite o Android Auto no telemóvel</string>
    <string name="carlink_setup_pair_accept_android_body">Siga os ecrãs do Android Auto em %1$s e mantenha-o desbloqueado.</string>
    <string name="carlink_setup_pair_kind_title">%1$s está emparelhado</string>
    <string name="carlink_setup_pair_kind_body">É um iPhone ou um telemóvel Android?</string>
    <string name="carlink_setup_pair_connected_title">%1$s está ligado</string>
    <string name="carlink_setup_pair_connected_body">%1$s está a funcionar. Da próxima vez inicia sozinho.</string>
    <string name="carlink_setup_pair_failed_title">Ainda não está ligado</string>
    <string name="carlink_setup_pair_failed_body">O telemóvel está emparelhado. Desbloqueie-o, verifique se o Bluetooth e o Wi-Fi estão ligados e tente novamente.</string>
    <string name="carlink_setup_pair_bt_off_title">Ligue o Bluetooth</string>
    <string name="carlink_setup_pair_bt_off_body">Os telemóveis encontram este ecrã por Bluetooth. Ligue-o para emparelhar.</string>
    <string name="carlink_setup_pair_bt_on">Ligar o Bluetooth</string>
    <string name="carlink_setup_pair_cable">Ligar com um cabo em vez disso</string>
    <string name="carlink_setup_pair_other">Usar outro telemóvel</string>
    <string name="carlink_setup_pair_external_bt">A ligação sem fios ainda não está disponível neste estéreo. Ligue o telemóvel com um cabo USB — funciona da mesma forma.</string>
    <string name="carlink_setup_pair_wireless">Emparelhar por Bluetooth em vez disso</string>
    <string name="carlink_setup_pair_skip">Saltar</string>
    <string name="carlink_setup_pair_cable_title">Ligue o telemóvel a este ecrã</string>
    <string name="carlink_setup_pair_cable_body">Use o cabo de carregamento do telemóvel na porta USB deste ecrã. Desbloqueie o telemóvel; o CarLink inicia sozinho.</string>
    <string name="carlink_setup_pair_cable_prompts">Ao ligar, o Android pede uma vez permissão para o CarLink — selecione “Abrir sempre o CarLink” — e um iPhone pede-lhe para Confiar neste ecrã.</string>
