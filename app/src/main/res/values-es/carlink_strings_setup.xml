    <string name="carlink_setup_welcome_title">Conectemos tu teléfono</string>
    <string name="carlink_setup_welcome_body">CarLink ejecuta Apple CarPlay para iPhone y Android Auto para teléfonos Android, por cable o de forma inalámbrica. La configuración tarda unos dos minutos.</string>
