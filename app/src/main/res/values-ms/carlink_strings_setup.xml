    <string name="carlink_setup_pair_waiting_title">Pada telefon anda, buka Bluetooth dan ketik %1$s</string>
    <string name="carlink_setup_pair_waiting_title_unnamed">Pada telefon anda, buka Bluetooth dan ketik nama skrin ini</string>
    <string name="carlink_setup_pair_waiting_body">Biarkan skrin ini terbuka. Jika telefon menunjukkan kod, pastikan ia sepadan di sini lalu ketik Pasangkan.</string>
    <string name="carlink_setup_pair_pairing_title">Memasangkan dengan %1$s…</string>
    <string name="carlink_setup_pair_pairing_title_unnamed">Memasangkan dengan telefon anda…</string>
