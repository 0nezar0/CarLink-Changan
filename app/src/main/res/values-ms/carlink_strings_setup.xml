    <string name="carlink_setup_pair_connected_body">%1$s sedang berjalan. Lain kali ia bermula sendiri.</string>
    <string name="carlink_setup_pair_failed_title">Belum disambungkan</string>
    <string name="carlink_setup_pair_failed_body">Telefon sudah dipasangkan. Buka kuncinya, pastikan Bluetooth dan Wi-Fi dihidupkan, lalu cuba lagi.</string>
