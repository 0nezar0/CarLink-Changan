    <string name="carlink_setup_welcome_title">Mari sambungkan telefon anda</string>
    <string name="carlink_setup_welcome_body">CarLink menjalankan Apple CarPlay untuk iPhone dan Android Auto untuk telefon Android, melalui kabel atau secara wayarles. Persediaan mengambil kira-kira dua minit.</string>
