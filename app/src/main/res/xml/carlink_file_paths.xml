<?xml version="1.0" encoding="utf-8"?>
<!-- What CarLinkFileProvider may serve: reports CarLink writes for sharing, and the update folder
     Downloads/CarLink (UpdateFiles.folder) for the manual install fallback. -->
<paths>
    <cache-path name="shared" path="shared/" />
    <!-- UpdateFiles.folder: public Download/CarLink (Android 9 and older with storage access). -->
    <external-path name="update_public" path="Download/CarLink/" />
    <!-- UpdateFiles.folder: CarLink's own Android/data/<package>/files/Download/CarLink. -->
    <external-files-path name="update_own" path="Download/CarLink/" />
    <!-- UpdateFiles.folder: last resort when no external storage exists. -->
    <cache-path name="update_cache" path="updates/CarLink/" />
</paths>
