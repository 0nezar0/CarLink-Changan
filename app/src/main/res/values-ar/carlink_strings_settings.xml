    <string name="carlink_settings_hide_bar_off">إيقاف</string>
    <string name="carlink_settings_hide_bar_off_detail">شريط حالة السيارة يبقى ظاهر.</string>
    <string name="carlink_settings_hide_bar_all">إخفاء الشريط في كل التطبيقات ما عدا الشاشة الرئيسية</string>
    <string name="carlink_settings_hide_bar_all_detail">الشريط يبقى ظاهر على الشاشة الرئيسية للسيارة (المشغّل). CarPlay و Android Auto ينخفي معهم الشريط دائماً في هذا الوضع.</string>
    <string name="carlink_settings_hide_bar_selected">إخفاء الشريط في تطبيقات أختارها</string>
    <string name="carlink_settings_hide_bar_selected_detail">علّم التطبيقات بعلامة ✔. CarPlay و Android Auto ينخفي معهم الشريط دائماً في هذا الوضع، حتى لو ما علّمت CarLink.</string>
    <string name="carlink_settings_hide_bar_accessibility_notice">تنبيه: لازم تفعّل إذن إمكانية الوصول لـ CarLink عشان يعرف التطبيق المفتوح ويخفي شريط الإشعارات.</string>
    <string name="carlink_settings_hide_bar_accessibility_on">إذن إمكانية الوصول مفعّل</string>
    <string name="carlink_settings_hide_bar_accessibility_off">إذن إمكانية الوصول غير مفعّل</string>
    <string name="carlink_settings_hide_bar_accessibility_button">فتح إعدادات إمكانية الوصول</string>
    <string name="carlink_settings_hide_bar_apps_heading">التطبيقات اللي ينخفي فيها الشريط</string>
    <string name="carlink_settings_hide_bar_apps_search">ابحث عن تطبيق</string>
    <string name="carlink_settings_hide_bar_apps_carlink">CarLink (دائماً مشمول)</string>
    <string name="carlink_fce_accessibility_label">إخفاء شريط الحالة في CarLink</string>
    <string name="carlink_fce_accessibility_description">يسمح لـ CarLink بمعرفة التطبيق الظاهر في المقدمة حتى يخفي أو يظهر شريط حالة السيارة، حسب إعدادات شانجان CS75 Plus.</string>
    <string name="carlink_settings_hide_car_status_bar">إخفاء شريط حالة السيارة</string>
    <string name="carlink_settings_hide_car_status_bar_detail">يخفي شريط الحالة العائم حق السيارة وأثناء عرض CarPlay أو Android Auto، عشان ما يغطي الصورة. يتطبّق على طول. إذا طفيته يبقى الشريط ظاهر. هذا الخيار التجريبي لشانجان CS75 Plus فقط.</string>
    <string name="carlink_settings_save_log">حفظ تقرير كامل</string>
    <string name="carlink_settings_save_log_detail">يحفظ إصدار التطبيق ومعلومات الجهاز والإعدادات وجلسات الجوال والسجل الكامل في ملف نصي واحد: على الفلاش إذا كان موصول، وإلا في Downloads/CarLink. كلمات المرور المحفوظة ما تنحفظ فيه. يشتغل بدون إنترنت.</string>
    <string name="carlink_settings_share_log">مشاركة سجل الأخطاء</string>
    <string name="carlink_settings_share_log_detail">يرسل نفس الملف عن طريق تطبيق ثاني في هذي الشاشة</string>
    <string name="carlink_settings_group_sound">الصوت</string>
