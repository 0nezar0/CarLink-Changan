    <string name="carlink_settings_method_sheet_body">Bluetooth her zaman bağlantıya başlar; resim ve ses daha sonra Wi-Fi üzerinden seyahat eder.</string>
    <string name="carlink_settings_hotspot">Araba noktaları</string>
