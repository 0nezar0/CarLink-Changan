    <string name="carlink_settings_method_same_wifi_detail">Bir yönlendiricide telefon ve araba, en hızlı yol. Bir kez Wi-Fi şifresine ihtiyaç var.</string>
    <string name="carlink_settings_method_hotspot_detail">Telefon, aracın yarattığı Wi-Fi noktalarına katılır. Her telefonla çalışır.</string>
    <string name="carlink_settings_method_direct_detail">Telefon ve araba arasında doğrudan bir bağlantı. Hiçbir ağ gerekli değil.</string>
    <string name="carlink_settings_method_headunit_server">Head Unit server (de Developmenter)</string>
